<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- 전체 컨텐츠 (헤더 + 일정표 타이틀 + 스크롤) -->
    <LinearLayout
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@+id/btnAddSchedule">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorPrimary"
            android:padding="12dp">

            <!-- 뒤로가기 + 타이틀 + 갤러리/일기 버튼 한 줄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_revert"
                    android:background="@android:color/transparent"
                    app:tint="@color/white"
                    android:contentDescription="뒤로가기"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="여행 상세"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"/>

                <!-- 갤러리/일기 버튼을 타이틀 오른쪽으로 이동 -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnGoGallery"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:background="@android:color/transparent"
                    app:tint="@color/white"
                    android:contentDescription="사진첩"/>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnGoDiary"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_edit"
                    android:background="@android:color/transparent"
                    app:tint="@color/white"
                    android:layout_marginStart="4dp"
                    android:contentDescription="여행 일기"/>
            </LinearLayout>

            <!-- 커버 이미지 + 여행 정보 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivTripCover"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:scaleType="centerCrop"
                    android:background="@color/colorDivider"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/ivTripCover"
                    android:layout_marginStart="10dp"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/tvDetailTripName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="여행 이름"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvDetailDestination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="목적지"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="날짜"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- 일정표 타이틀 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/white"
            android:paddingStart="16dp"
            android:gravity="center_vertical"
            android:text="일정표"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"/>

        <!-- 스크롤 영역 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptySchedules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:text="@string/no_schedules"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"/>

                <TableLayout
                    android:id="@+id/tableSchedules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="2"
                    android:padding="4dp">

                    <!-- 헤더 행 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/colorPrimary">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="날짜"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:text="시간"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="장소/활동"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:textSize="13sp"/>

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="완료"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:padding="8dp"
                            android:textSize="13sp"/>
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- FAB: RelativeLayout 덕분에 항상 오른쪽 하단에 고정 -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnAddSchedule"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:background="@drawable/fab_background"
        android:contentDescription="일정 추가"
        android:elevation="6dp"/>

</RelativeLayout>