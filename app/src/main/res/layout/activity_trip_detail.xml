<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- 여행 정보 헤더 -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivTripCover"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                android:background="@color/colorDivider"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/ivTripCover"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tvDetailTripName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="여행 이름"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvDetailDestination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="목적지"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvDetailDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="날짜"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- 하단 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <ImageButton
                android:id="@+id/btnGoGallery"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="@android:color/transparent"
                android:tint="@color/white"
                android:contentDescription="사진첩"/>

            <ImageButton
                android:id="@+id/btnGoDiary"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="@android:color/transparent"
                android:tint="@color/white"
                android:layout_marginStart="8dp"
                android:contentDescription="여행 일기"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 일정 추가 버튼 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="일정표"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_centerVertical="true"/>

        <ImageButton
            android:id="@+id/btnAddSchedule"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_input_add"
            android:background="@color/colorPrimary"
            android:tint="@color/white"
            android:contentDescription="일정 추가"/>
    </RelativeLayout>

    <!-- 일정 없을 때 안내 -->
    <TextView
        android:id="@+id/tvEmptySchedules"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="@string/no_schedules"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- 일정 스크롤 영역 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TableLayout: 일정표 -->
        <TableLayout
            android:id="@+id/tableSchedules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="2"
            android:padding="8dp">

            <!-- 헤더 행 -->
            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:padding="8dp">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="날짜"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:padding="6dp"/>

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="시간"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:padding="6dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="장소/활동"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:padding="6dp"/>

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:text="완료"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:padding="6dp"/>
            </TableRow>
        </TableLayout>
    </ScrollView>

</LinearLayout>