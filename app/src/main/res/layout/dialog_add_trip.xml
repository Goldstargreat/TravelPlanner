<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/colorPrimary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="새 여행 추가"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- 입력 필드 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 여행 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여행 이름 *"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etTripName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="여행 이름을 입력하세요"
                android:inputType="text"
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="14sp"/>

            <!-- 목적지 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목적지"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etTripDestination"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="예) 일본 도쿄"
                android:inputType="text"
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="14sp"/>

            <!-- 출발일 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="출발일"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etStartDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="예) 2024-05-01"
                android:inputType="date"
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="14sp"/>

            <!-- 귀국일 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="귀국일"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:layout_marginTop="16dp"/>

            <EditText
                android:id="@+id/etEndDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="예) 2024-05-07"
                android:inputType="date"
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="14sp"/>

            <!-- 버튼 row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btnConfirmAddTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="추가"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@color/colorPrimary"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnCancelAddTrip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="취소"
                    android:textColor="@color/colorTextSecondary"
                    android:background="@android:color/white"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>