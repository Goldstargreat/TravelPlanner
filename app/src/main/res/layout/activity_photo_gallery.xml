<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- 커스텀 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBackGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@android:color/transparent"
            android:contentDescription="뒤로가기"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="사진첩"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 헤더 오른쪽 + 버튼 -->
        <ImageButton
            android:id="@+id/btnAddPhoto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@android:color/transparent"
            android:contentDescription="사진 추가"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- 사진 그리드 + 빈 화면 + 상세보기 오버레이 -->
    <FrameLayout
        android:id="@+id/framePhotoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <GridView
            android:id="@+id/gridViewPhotos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:horizontalSpacing="2dp"
            android:verticalSpacing="2dp"
            android:stretchMode="columnWidth"
            android:padding="2dp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvNoPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_photos"
            android:textColor="@color/colorTextSecondary"
            android:textSize="16sp"
            android:visibility="gone"/>

        <!-- 사진 상세보기 오버레이 -->
        <RelativeLayout
            android:id="@+id/layoutPhotoDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorTextPrimary"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivPhotoDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"/>

            <ImageButton
                android:id="@+id/btnCloseDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="@android:color/transparent"
                android:contentDescription="닫기"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnDeletePhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="16dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="@android:color/transparent"
                android:contentDescription="삭제"
                app:tint="@color/white" />
        </RelativeLayout>

    </FrameLayout>

</LinearLayout>