<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorCardBg"
    android:padding="12dp"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/ivTripThumb"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:background="@color/colorDivider"/>

    <TextView
        android:id="@+id/tvTripName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivTripThumb"
        android:layout_marginStart="12dp"
        android:layout_alignTop="@id/ivTripThumb"
        android:layout_marginTop="4dp"
        android:text="여행 이름"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"/>

    <TextView
        android:id="@+id/tvTripDestination"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivTripThumb"
        android:layout_below="@id/tvTripName"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="목적지"
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary"/>

    <TextView
        android:id="@+id/tvTripDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/ivTripThumb"
        android:layout_below="@id/tvTripDestination"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="2024.01.01 ~ 2024.01.07"
        android:textSize="12sp"
        android:textColor="@color/colorTextSecondary"/>

    <TextView
        android:id="@+id/tvScheduleCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="0개 일정"
        android:textSize="12sp"
        android:textColor="@color/colorPrimary"
        android:background="@drawable/badge_background"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"/>

</RelativeLayout>