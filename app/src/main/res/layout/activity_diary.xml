<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- 메인 화면: 헤더 + 카드 그리드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 커스텀 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@color/colorPrimary"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBackDiary"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="@android:color/transparent"
                android:contentDescription="뒤로가기"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="여행 일기"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 카드 그리드 -->
        <ScrollView
            android:id="@+id/scrollDiaryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <GridLayout
                android:id="@+id/gridDiaryCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp" />

        </ScrollView>

    </LinearLayout>

    <!-- 에디터 오버레이: 새 일기 작성 시 전체 덮음 -->
    <ScrollView
        android:id="@+id/scrollDiaryEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/etDiaryTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="일기 제목"
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:inputType="text" />

            <EditText
                android:id="@+id/etDiaryDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="날짜 (예: 2024-01-01)"
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="14sp"
                android:inputType="text" />

            <RadioGroup
                android:id="@+id/radioGroupVisibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/radioPublic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="공개"
                    android:textSize="13sp"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioPrivate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비공개"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp" />
            </RadioGroup>

            <EditText
                android:id="@+id/etDiaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="200dp"
                android:layout_marginTop="8dp"
                android:hint="여행의 추억을 기록하세요..."
                android:background="@drawable/input_background"
                android:padding="8dp"
                android:textSize="14sp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:lines="8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCancelDiary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="취소"
                    android:textColor="@color/colorPrimary"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="16dp" />

                <Button
                    android:id="@+id/btnShareDiary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="공유"
                    android:textColor="@color/colorPrimary"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="16dp" />

                <Button
                    android:id="@+id/btnSaveDiary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="저장"
                    android:textColor="@color/white"
                    android:background="@color/colorPrimary"
                    android:paddingHorizontal="24dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 사용하지 않지만 Java 코드 참조 오류 방지용 더미 뷰 -->
    <ImageButton
        android:id="@+id/btnNewDiary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="새 일기" />

</FrameLayout>